# Everything here is OPTIONAL — the app runs on Sepolia with free public endpoints out of the box.
# Every VITE_* value is bundled into the browser JavaScript and is PUBLIC. Never put a secret here.
# If you use a keyed RPC provider (Alchemy, Infura…), restrict that key to your site's domain
# in the provider's dashboard.

# Which chain the app talks to: "sepolia" (default) or "localhost" (local Hardhat node).
VITE_CHAIN=

# Sepolia RPC(s) for read-only access. Comma-separate several for fallback order.
# Default: https://ethereum-sepolia-rpc.publicnode.com, https://sepolia.gateway.tenderly.co
VITE_SEPOLIA_RPC_URL=

# Local Hardhat node URL when VITE_CHAIN=localhost. Default: http://127.0.0.1:8545
VITE_LOCAL_RPC_URL=

# Mainnet RPC used only to look up ENS names. Default: https://ethereum-rpc.publicnode.com
VITE_MAINNET_RPC_URL=

# WalletConnect / Reown project id (cloud.reown.com). Leave empty to offer browser wallets only;
# set it to also offer QR-code/mobile wallets.
VITE_WALLETCONNECT_PROJECT_ID=
