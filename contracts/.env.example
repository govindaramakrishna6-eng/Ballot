# Copy to `.env` (gitignored). Everything here is optional except the deployer key for Sepolia,
# which `npm run wallet:new` writes for you — never paste a key by hand into chat or commits.

# Optional override. Defaults to free public RPCs (publicnode, then Tenderly gateway).
# Comma-separate several URLs to set your own fallback order.
SEPOLIA_RPC_URL=

# Throwaway Sepolia-only deployer key. Generated by `npm run wallet:new`.
DEPLOYER_PRIVATE_KEY=

# Optional. If set, contracts are also verified on Etherscan (Sourcify is always used).
ETHERSCAN_API_KEY=
