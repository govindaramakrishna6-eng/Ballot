# Everything prefixed VITE_ is bundled into the browser JS and is PUBLIC.
# Restrict the RPC key to your domain in your provider's dashboard.

# Sepolia JSON-RPC endpoint used for read-only access (no wallet needed).
VITE_SEPOLIA_RPC_URL=

# WalletConnect / Reown Cloud project id (used by RainbowKit for mobile wallets).
VITE_WALLETCONNECT_PROJECT_ID=
