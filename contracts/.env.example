# Fill these in a local `.env` (never commit it). Only needed for Sepolia deploy/verify.

# Sepolia JSON-RPC endpoint (Alchemy, Infura, etc.). Server-side only, not shipped to browsers.
SEPOLIA_RPC_URL=

# Private key of a throwaway deployer wallet funded with Sepolia ETH only.
# Alternative: `npx hardhat keystore set DEPLOYER_PRIVATE_KEY` stores it encrypted instead.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key (one key works for Sepolia via Etherscan API v2).
ETHERSCAN_API_KEY=
