{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node20",
    "target": "es2023",
    "skipLibCheck": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "strict": true,
    // Scripts run directly with Node's built-in type stripping, which needs explicit .ts imports
    // and only "erasable" TypeScript (no enums/namespaces). tsc is used for type checking only.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  }
}
